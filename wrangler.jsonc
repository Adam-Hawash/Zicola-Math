{
        "$schema": "node_modules/wrangler/config-schema.json",
        "main": ".open-next/worker.js",
        "name": "zicola-math",
        "compatibility_date": "2026-11-18",
        "compatibility_flags": [
                "nodejs_compat",
                "global_fetch_strictly_public"
        ],
        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS"
        },
        /* (ر8) بناء OpenNext قبل أي deploy + باتش الـ instrumentation الديناميكي.
           مهم: أمر deploy في اللوحة (npx wrangler deploy) ما بيصنعش .open-next
           بنفسه — بيكشف OpenNext وبينادي opennextjs-cloudflare deploy اللي بيقرا
           الكومبايلد كونفج بس ويرفض لو مش موجود («Could not find compiled Open
           Next config»). فأمر البناء في لوحة كلاود فلير لازم يكون:
               bun run build:cf
           وهو نفس الأمر اللي هنا بالظبط (سكريبت build:cf في package.json). */
        "build": {
                "command": "npx opennextjs-cloudflare build && node scripts/patch-cf-instrumentation.mjs && node scripts/patch-cf-worker-entry.mjs"
        },
        "services": [
                {
                        // Self-reference service binding, the service name must match the worker name
                        // see https://opennext.js.org/cloudflare/caching
                        "binding": "WORKER_SELF_REFERENCE",
                        "service": "zicola-math"
                }
        ],
        /* (ر26) keep-warm كل دقيقتين —scheduled handler في worker.js (باتش
           ر26) بيندّي على الرئيسية وكل APIs اللند عشان العزل يفضل دافي —
           من غيرها المستر بيلاقي المنصة بتفضل تحمل كل ما يدخل (isolate
           بارد = 1.2-2.3s TTFB بدل 0.07s دافي). كل النداءات محمية بـ
           try/catch فالفشل صامت ومش بيظهر كأخطاء في اللوحة. */
        "triggers": {
                "crons": ["*/2 * * * *"]
        },
        "images": {
                // Enable image optimization
                // see https://opennext.js.org/cloudflare/howtos/image
                "binding": "IMAGES"
        }
}